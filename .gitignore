# run without these two files; only 01_data_preparation.Rmd needs them.
Raw_data/Biosample_Strait_of_Georgia.csv
Raw_data/SOG_herring_catch_all_fishing_types.csv
Raw_data/SOG_herring_catch_all_fishing_types_2026_03_11.csv

